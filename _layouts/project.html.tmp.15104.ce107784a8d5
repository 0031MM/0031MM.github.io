---
layout: default
---
<div class="project-layout">
  <div class="project-meta-col">
    <ul class="project-meta">
      <li><strong>Client</strong> {{ page.client }}</li>
      <li><strong>Location</strong> {{ page.location }}</li>
      <li><strong>Size</strong> {{ page.size }}</li>
      <li><strong>Year</strong> {{ page.year }}</li>
    </ul>
  </div>
  <div class="project-content">{{ content }}</div>
  <div class="project-images"></div>
</div>
<script>
  (function() {
    var content = document.querySelector('.project-content');
    var images = content.querySelectorAll('p:has(img)');
    var imagesDiv = document.querySelector('.project-images');
    images.forEach(function(p) { imagesDiv.appendChild(p); });
  })();
</script>
